            }

            .hero h1 {
                letter-spacing: 0;
            }

            .hero-description {
                font-size: 16px;
            }

            .hero-buttons a {
                width: 100%;
            }

            .hero-price {
                display: block;
            }

            .hero-price strong {
                display: block;
                margin-bottom: 5px;
            }

            .hero-visual {

                min-height: 340px;

                margin-top: 45px;
            }

            .hero-photo {
                height: 340px;
            }

            .hero-photo-note {
                left: 10px;
                bottom: 14px;
                max-width: 205px;
            }

            .hero-photo-detail {
                width: 38%;
                height: 130px;
                right: 8px;
                bottom: 8px;
            }

            .preview-body {
                padding: 20px;
            }

            .floating-box {

                font-size: 11px;

                padding: 9px 12px;
            }

            .float-1 {
                right: 0;
            }

            .float-2 {
                left: 0;
            }

            .float-3 {
                right: 5px;
            }

            .offer-card {
                padding: 30px 22px;
            }

            .offer-price {
                font-size: 45px;
            }

            .cta-box {
                padding: 50px 25px;
            }

            .contact-card {
                padding: 25px;
            }

            .offer-content {
                gap: 8px;
            }
        }

        body {
            background: #fffefa;
        }

        .section-padding {
            padding: 88px 0;
        }

        .section-title h2,
        .hero h1,
        .offer-card h2 {
            font-family: "Manrope", sans-serif;
            letter-spacing: 0;
        }

        .section-title h2 {
            font-size: 44px;
        }

        .hero h1 {
            font-size: 64px;
            line-height: 1.08;
        }

        .navbar {
            background: rgba(255, 254, 250, .97);
            border-color: var(--border);
        }

        .btn-primary-custom,
        .btn-outline-custom,
        .btn-white {
            border-radius: 8px;
        }

        .hero-photo,
        .service-card,
        .offer-card,
        .delivery-card,
        .extra-card,
        .contact-card {
            border-radius: 10px;
        }

        .service-card:hover {
            border-color: #b8d2c5;
            box-shadow: 0 16px 36px rgba(24, 52, 47, .08);
        }

        .offer-content strong,
        .delivery-number {
            color: #f2a477;
        }

        .offer-card {
            box-shadow: 0 22px 55px rgba(24, 52, 47, .08);
        }

        .cta-box {
            border-radius: 10px;
        }

        .footer-brand span {
            color: #f2a477;
        }

        .form-control:focus,
        .form-select:focus {
            box-shadow: 0 0 0 .2rem rgba(23, 107, 91, .12);
        }

        @media (max-width: 991px) {
            .hero h1 {
                font-size: 52px;
            }
        }

        @media (max-width: 767px) {
            .section-padding {
                padding: 64px 0;
            }

            .section-title h2,
            .cta-box h2 {
                font-size: 34px;
            }

            .hero h1 {
                font-size: 42px;
            }
        }

        .navbar-brand,
        .navbar-nav .nav-link,
        .service-card h3,
        .process-card h4,
        .extra-card h3,
        .contact-card h3,
        .accordion-button,
        footer h5 {
            font-family: "Manrope", sans-serif;
        }

        .navbar-nav .nav-link {
            color: var(--text);
            font-size: 14px;
        }

        .navbar-toggler {
            border-color: var(--border);
            border-radius: 8px;
        }

        .section-label {
            border-radius: 8px;
            background: #e8f1eb;
        }

        .hero {
            padding-top: 145px;
            padding-bottom: 85px;
        }

        .hero-badge {
            border-radius: 8px;
            box-shadow: none;
        }

        .hero-description {
            max-width: 560px;
            color: #596d66;
        }

        .hero-photo {
            border-radius: 12px;
        }

        .hero-photo-note {
            border: 1px solid var(--border);
        }

        .btn-primary-custom {
            box-shadow: 0 8px 18px rgba(23, 107, 91, .14);
        }

        .btn-outline-custom {
            background: rgba(255, 254, 250, .7);
        }

        .offer-strip {
            border-top: 1px solid rgba(255, 255, 255, .1);
        }

        .offer-content strong {
            color: #f2a477;
        }

        .service-card {
            display: flex;
            flex-direction: column;
            padding: 28px;
            background: #fffefa;
        }

        .service-icon {
            background: #f9e9df;
            color: #bd603b;
            border-radius: 10px;
        }

        .service-card h3 {
            font-size: 20px;
        }

        .service-card .service-list {
            flex: 1;
        }

        .service-card > a,
        .extra-card > a {
            color: var(--primary);
            font-weight: 700;
        }

        .website-offer,
        .contact-section {
            background: #f1f4ee;
        }

        .offer-card {
            background: #fffefa;
        }

        .delivery-number {
            color: #f2a477;
        }

        .delivery-card {
            border-radius: 10px;
        }

        .process-number {
            border-radius: 10px;
            background: #f9e9df;
            color: #bd603b;
        }

        .extra-card {
            border-radius: 10px;
            transition: transform .2s ease, box-shadow .2s ease;
        }

        .extra-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 16px 36px rgba(24, 52, 47, .08);
        }

        .accordion-button:not(.collapsed) {
            color: var(--primary);
            background: #edf4ee;
        }

        .accordion-button:focus {
            border-color: var(--border);
            box-shadow: 0 0 0 .2rem rgba(23, 107, 91, .12);
        }

        .contact-card {
            background: #fffefa;
        }

        .form-control,
        .form-select {
            border-radius: 8px;
        }

        footer {
            background: var(--dark);
            color: #bdccc5;
        }

        footer a {
            color: #bdccc5;
        }

        @media (min-width: 992px) {
            .hero-visual,
            .hero-photo {
                min-height: 520px;
                height: 520px;
            }
        }

        @media (max-width: 767px) {
            .hero {
                padding-top: 112px;
                padding-bottom: 64px;
            }

            .hero-visual,
            .hero-photo {
                min-height: 350px;
                height: 350px;
            }

            .section-title {
                margin-bottom: 40px;
            }

            .service-card {
                padding: 24px;
            }
        }

    </style>

</head>

