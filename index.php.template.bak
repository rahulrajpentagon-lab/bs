<?php
// ============================================================
// KAYACODE - BUSINESS WEBSITE
// File: index.php
// ============================================================

$companyName = "Kayacode";
$tagline = "Focus on Your Product. We Deliver Your Website in One Week.";

$phone = "+91 98765 43210";
$email = "hello@kayacode.com";
$whatsapp = "919876543210";
$location = "Kerala, India";

// Contact form message
$successMessage = "";
$errorMessage = "";

if ($_SERVER["REQUEST_METHOD"] === "POST") {

    $name = trim($_POST["name"] ?? "");
    $businessNameInput = trim($_POST["business_name"] ?? "");
    $emailInput = trim($_POST["email"] ?? "");
    $phoneInput = trim($_POST["phone"] ?? "");
    $service = trim($_POST["service"] ?? "");
    $message = trim($_POST["message"] ?? "");

    if ($name === "" || $businessNameInput === "" || $emailInput === "" || $message === "") {

        $errorMessage = "Please fill in all required fields.";

    } elseif (!filter_var($emailInput, FILTER_VALIDATE_EMAIL)) {

        $errorMessage = "Please enter a valid email address.";

    } else {

        $inquiryDetails = "Business: {$businessNameInput}\r\n"
            . "Name: {$name}\r\n"
            . "Email: {$emailInput}\r\n"
            . "Phone: {$phoneInput}\r\n"
            . "Service: {$service}\r\n\r\n"
            . "Project details and ideas:\r\n{$message}";

        $headers = "From: {$companyName} Website <{$email}>\r\n"
            . "Reply-To: {$emailInput}\r\n"
            . "Content-Type: text/plain; charset=UTF-8";

        if (mail($email, "New business inquiry", $inquiryDetails, $headers)) {
            $successMessage = "Thank you! Your inquiry has been sent. We will reply within one day with your price details.";
        } else {
            $errorMessage = "We could not send your inquiry right now. Please email {$email} or contact us on WhatsApp.";
        }
    }
}
?>

